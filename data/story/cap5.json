  "scenes": [
    {
      "type": "dialog",
      "title": "AGE V · Apogeu & Segregação",
      "bg": {
        "color": "#3a2a4a",
        "image": "cards/c47.webp"
      },
      "cards": [
        "C47"
      ],
      "lines": [
        {
          "who": "mula",
          "text": "1710 a 1752: a Matriz de Santo Antônio. 42 anos de obra."
        },
        {
          "who": "buck",
          "text": "42 years to build, 482 kilos of gold on the walls?"
        },
        {
          "who": "mula",
          "text": "Segundo os registros locais. Ouro Preto diz que a deles é a segunda… mas conta a prata. A gente não."
        },
        {
          "who": "buck",
          "text": "A guide rivalry older than college football. Alabama vs. Auburn!"
        }
      ],
      "egg": {
        "label": "👁️ Contar os rostos",
        "ach": "estipite",
        "card": "C47",
        "lines": [
          {
            "who": "narr",
            "text": "Na Matriz, uma coluna estípite tem rostos esculpidos. Conte: menina, moça, mulher, velha."
          },
          {
            "who": "mula",
            "text": "As quatro idades da mulher numa coluna só. Tudo passa, menos a fila para casar na Matriz."
          },
          {
            "who": "buck",
            "text": "Four faces, one column. The whole life in one piece of wood."
          }
        ]
      }
    },
    {
      "type": "name",
      "title": "Uma igreja para cada grupo",
      "bg": {
        "color": "#3a2a4a",
        "image": "cards/c48.webp"
      },
      "cards": [
        "C48"
      ],
      "rounds": [
        {
          "date": "Matriz · Carmo · São Francisco",
          "place": "Quem rezava aqui?",
          "options": [
            "“Homens bons”: brancos ricos",
            "Africanos",
            "Mulatos e pardos"
          ],
          "answer": 0
        },
        {
          "date": "Rosário",
          "place": "E no Rosário?",
          "options": [
            "Africanos",
            "Brancos ricos",
            "Crioulos"
          ],
          "answer": 0
        },
        {
          "date": "Mercês",
          "place": "E nas Mercês?",
          "options": [
            "Crioulos: filhos de africanos nascidos aqui",
